{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Travel Project 1.0",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "intent",
    "locale",
    "days",
    "brief"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,39}$"
    },
    "intent": {
      "enum": [
        "plan",
        "record",
        "inspiration"
      ]
    },
    "locale": {
      "type": "string",
      "minLength": 1
    },
    "days": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": {
        "type": "object",
        "required": [
          "id",
          "tripDay",
          "date",
          "city",
          "title",
          "entries"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"
          },
          "tripDay": {
            "type": "integer",
            "minimum": 1
          },
          "date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ]
          },
          "city": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "entries": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "label",
                "notes",
                "time",
                "provenance",
                "visibility"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "notes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "time": {
                  "type": "object",
                  "required": [
                    "kind",
                    "display"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "start",
                        "end",
                        "range",
                        "approximate",
                        "unknown"
                      ]
                    },
                    "display": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false,
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "kind": {
                            "const": "unknown"
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "display": {
                            "const": ""
                          }
                        }
                      },
                      "else": {
                        "properties": {
                          "display": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      }
                    }
                  ]
                },
                "provenance": {
                  "type": "object",
                  "required": [
                    "sourceId",
                    "status"
                  ],
                  "properties": {
                    "sourceId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "status": {
                      "enum": [
                        "confirmed",
                        "proposed",
                        "unknown"
                      ]
                    }
                  },
                  "additionalProperties": false
                },
                "visibility": {
                  "enum": [
                    "private",
                    "public"
                  ]
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "uri",
          "role",
          "rights"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"
          },
          "uri": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "photo",
              "style-reference"
            ]
          },
          "rights": {
            "enum": [
              "user-owned",
              "permitted",
              "unknown"
            ]
          },
          "dayId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"
          }
        },
        "additionalProperties": false
      }
    },
    "brief": {
      "type": "object",
      "required": [
        "format",
        "skin",
        "renderMode",
        "size",
        "allowSplit",
        "requireExactSize",
        "publication"
      ],
      "properties": {
        "format": {
          "enum": [
            "day-timeline",
            "trip-overview",
            "photo-memory"
          ]
        },
        "skin": {
          "enum": [
            "indigo-journal",
            "clean-guide"
          ]
        },
        "renderMode": {
          "enum": [
            "auto",
            "whole-image",
            "precise-layout"
          ]
        },
        "size": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 256,
              "maximum": 8192
            },
            {
              "type": "integer",
              "minimum": 256,
              "maximum": 8192
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "allowSplit": {
          "type": "boolean"
        },
        "requireExactSize": {
          "type": "boolean"
        },
        "publication": {
          "enum": [
            "private",
            "public"
          ]
        }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
